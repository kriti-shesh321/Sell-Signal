# --- required ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full   # hosted Postgres: use the direct (unpooled) URL
PORT=8080
CORS_ORIGIN=http://localhost:5173                                       # comma-separated; add the frontend URL in prod
# --- discovery ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIRROR_URL=https://overpass.kumi.systems/api/interpreter
MAX_DISCOVER=40
# --- crawling (be polite) ---
USER_AGENT=SellSignal/0.1 (+https://github.com/kriti-shesh321/Sell-Signal)
FETCH_TIMEOUT_MS=8000
CRAWL_CONCURRENCY=5
CACHE_TTL_DAYS=7
CACHE_TTL_UNREACHABLE_DAYS=1
# --- optional AI fallback (Gemini) ---
AI_FALLBACK=off                 # on | off; also needs GEMINI_API_KEY
AI_MODEL=                       # blank = gemini-3.1-flash-lite
AI_MAX_CALLS_PER_RUN=25
AI_REQUESTS_PER_MINUTE=15       # Gemini free tier limit; raise on a paid plan
GEMINI_API_KEY=
# --- tests only ---
TEST_DATABASE_URL=
