{
  "name": "sellsignal-server",
  "version": "0.1.0",
  "description": "SellSignal API: discovery, enrichment and acquisition readiness scoring",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql && cp src/sources/sample-synthetic.csv dist/sources/sample-synthetic.csv",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "report:dedupe": "tsx scripts/dedupe-report.ts",
    "probe": "tsx scripts/probe.ts",
    "report:extract": "tsx scripts/extract-report.ts"
  },
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "robots-parser": "^3.0.1",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
